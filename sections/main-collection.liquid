<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <span class="eyebrow">CATALOGO OPERE</span>
      <h2>{{ collection.title | default: "Tutti i Ritratti Muso d’Autore" }}</h2>
      <p>{{ collection.description | default: "Scegli l'opzione perfetta per trasformare la foto del tuo animale in un'opera d'arte da conservare per sempre." }}</p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:34px;">
      {% for product in collection.products %}
        <div style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-sm); transition:var(--transition);" class="product-card">
          <a href="{{ product.url }}">
            {% if product.featured_media %}
              <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="300" height="300" style="width:100%; aspect-ratio:1/1; object-fit:cover;" loading="lazy">
            {% else %}
              <img src="{{ 'hero-bea.png' | asset_url }}" alt="Muso d'Autore" width="300" height="300" style="width:100%; aspect-ratio:1/1; object-fit:cover;" loading="lazy">
            {% endif %}
          </a>
          <div style="padding:24px;">
            <span class="eyebrow" style="font-size:11px; margin-bottom:6px;">DISPONIBILE DIGITAL O STAMPA</span>
            <h3 style="font-family:var(--serif); font-size:22px; margin:0 0 10px;">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
              <span style="font-weight:700; font-size:20px; color:var(--terra);">{{ product.price | money }}</span>
              <a href="{{ product.url }}" class="button button--secondary" style="padding:10px 18px; font-size:14px;">Personalizza →</a>
            </div>
          </div>
        </div>
      {% else %}
        <!-- Fallback Product Cards for Demo -->
        <div style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-sm);" class="product-card">
          <a href="/products/caricatura-personalizzata-1-animale">
            <img src="{{ 'hero-bea.png' | asset_url }}" alt="Caricatura 1 Animale" width="300" height="300" style="width:100%; aspect-ratio:1/1; object-fit:cover;">
          </a>
          <div style="padding:24px;">
            <span class="eyebrow" style="font-size:11px; margin-bottom:6px;">PIÙ VENDUTO</span>
            <h3 style="font-family:var(--serif); font-size:22px; margin:0 0 10px;">
              <a href="/products/caricatura-personalizzata-1-animale">Caricatura D'Autore - 1 Animale</a>
            </h3>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
              <span style="font-weight:700; font-size:20px; color:var(--terra);">39,00 €</span>
              <a href="/products/caricatura-personalizzata-1-animale" class="button button--secondary" style="padding:10px 18px; font-size:14px;">Personalizza →</a>
            </div>
          </div>
        </div>

        <div style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-sm);" class="product-card">
          <a href="/products/caricatura-coppia-2-animali">
            <img src="{{ 'come-funziona.png' | asset_url }}" alt="Caricatura 2 Animali" width="300" height="300" style="width:100%; aspect-ratio:1/1; object-fit:cover;">
          </a>
          <div style="padding:24px;">
            <span class="eyebrow" style="font-size:11px; margin-bottom:6px;">RITRATTO DI COPPIA</span>
            <h3 style="font-family:var(--serif); font-size:22px; margin:0 0 10px;">
              <a href="/products/caricatura-coppia-2-animali">Caricatura D'Autore - 2 Animali</a>
            </h3>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
              <span style="font-weight:700; font-size:20px; color:var(--terra);">59,00 €</span>
              <a href="/products/caricatura-coppia-2-animali" class="button button--secondary" style="padding:10px 18px; font-size:14px;">Personalizza →</a>
            </div>
          </div>
        </div>

        <div style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-sm);" class="product-card">
          <a href="/products/buono-regalo-muso-d-autore">
            <img src="{{ 'bea-mascotte.png' | asset_url }}" alt="Buono Regalo" width="300" height="300" style="width:100%; aspect-ratio:1/1; object-fit:cover;">
          </a>
          <div style="padding:24px;">
            <span class="eyebrow" style="font-size:11px; margin-bottom:6px;">REGALO SPECIALE</span>
            <h3 style="font-family:var(--serif); font-size:22px; margin:0 0 10px;">
              <a href="/products/buono-regalo-muso-d-autore">Buono Regalo Muso d'Autore</a>
            </h3>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
              <span style="font-weight:700; font-size:20px; color:var(--terra);">da 39,00 €</span>
              <a href="/products/buono-regalo-muso-d-autore" class="button button--secondary" style="padding:10px 18px; font-size:14px;">Scegli taglio →</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collezione Prodotti",
  "settings": [],
  "presets": [
    {
      "name": "Collezione Prodotti"
    }
  ]
}
{% endschema %}
