<section class="section page-width spotlight">
  <div>
    <img src="{{ 'bea-mascotte.png' | asset_url }}" alt="Bea, musa e mascotte di Muso d’Autore" width="600" height="600" style="border-radius:var(--radius-lg); box-shadow:var(--shadow-lg);" loading="lazy">
  </div>
  <div>
    <span class="eyebrow">IL PRIMO RITRATTO D'AUTORE</span>
    <h2 style="font-family:var(--serif); font-size:clamp(32px, 4vw, 50px); margin:12px 0 20px;">Conosci Bea, la nostra musa</h2>
    <p style="font-size:18px; color:var(--ink-light); line-height:1.7; margin-bottom:24px;">
      È da uno sguardo unico come quello di Bea che nasce <strong>Muso d’Autore</strong>. Ogni opera che realizziamo nasce dalla passione di immortalare non soltanto i tratti del viso, ma l'espressione, il carattere e il legame profondo che ci unisce ai nostri compagni di vita.
    </p>
    <a class="button button--secondary" href="/collections/all">Esplora i Ritratti Personalizzati →</a>
  </div>
</section>

