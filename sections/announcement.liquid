{% if section.settings.show_announcement %}
  <div class="announcement-bar">
    {{ section.settings.text }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Barra Annuncio",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostra barra annuncio",
      "default": true
    },
    {
      "type": "html",
      "id": "text",
      "label": "Testo Annuncio",
      "default": "🎨 <strong>Spedizione Gratuita</strong> in tutta Italia per ordini superiori a 50€ | Anteprima in 48 ore!"
    }
  ],
  "presets": [
    {
      "name": "Barra Annuncio"
    }
  ]
}
{% endschema %}
