<section class="section page-width product"><div class="product__media">{% for media in product.media %}{{ media | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% else %}<img src="{{ 'hero-bea.png' | asset_url }}" alt="Esempio caricatura" width="1200" height="800">{% endfor %}</div><div class="product__info"><p class="eyebrow">CREATO SOLO PER TE</p><h1>{{ product.title }}</h1><div class="price">{{ product.price | money }}</div>{{ product.description }}{% form 'product', product %}{% unless product.has_only_default_variant %}<label for="variant">Scegli l’opzione</label><select id="variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}">{{ variant.title }} · {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<button class="button" type="submit">Inizia il tuo ritratto</button>{% endform %}<ul class="product-trust"><li>Una revisione leggera inclusa</li><li>File digitale ad alta risoluzione</li><li>Stampe controllate e confezionate a mano</li></ul></div></section>
{% schema %}{"name":"Prodotto principale","settings":[]}{% endschema %}
