<section class="hero">
  <div class="page-width hero__grid">
    <div class="hero__copy">
      <span class="eyebrow">🎨 RITRATTI ARTISTICI DI ANIMALI</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <a class="button" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.button }}</a>
      <div class="trustline">
        <span>✦ Disegnato a mano in Procreate</span>
        <span>✦ Anteprima in 48 ore</span>
        <span>✦ Digitale o Stampa Fine Art</span>
      </div>
    </div>

    <div class="hero__media">
      <img src="{{ 'hero-bea.png' | asset_url }}" alt="Caricatura artistica d'autore di Bea" width="900" height="900" loading="eager">
      <div class="hero__badge-floating">
        <div style="font-size:24px;">🐾</div>
        <div>
          <strong style="display:block; font-size:14px;">Musa Ufficiale: Bea</strong>
          <span style="font-size:12px; color:var(--ink-light);">Oltre 350+ cuccioli disegnati</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Premium",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo Principale",
      "default": "Il tuo animale diventa un’opera d’autore"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Testo Descrizione",
      "default": "Trasformiamo l'espressione, il carattere e l'anima del tuo compagno di vita in una caricatura unica, disegnata a mano con passione."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Testo Pulsante",
      "default": "Crea Ora la Tua Caricatura 🎨"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link Pulsante"
    }
  ],
  "presets": [
    {
      "name": "Hero Premium"
    }
  ]
}
{% endschema %}
