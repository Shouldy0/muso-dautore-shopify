<section class="section" style="background-color:var(--ink); color:var(--white);">
  <div class="page-width" style="display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;">
    <div data-animate>
      <span class="eyebrow" style="color:var(--ochre);">L'IDEA REGALO PERFETTA</span>
      <h2 style="font-family:var(--serif); font-size:clamp(32px, 4vw, 52px); margin:16px 0;">Sorprendi chi ama davvero il suo animale</h2>
      <p style="font-size:18px; opacity:0.85; margin-bottom:28px;">
        Un ritratto d'autore è un regalo personale, originale ed emozionante per compleanni, festività o per celebrare l'amore per i propri cuccioli.
      </p>
      <a href="/products/buono-regalo-muso-d-autore" class="button" style="background-color:var(--ochre); border-color:var(--ochre); color:var(--ink);">Regala un Ritratto D'Autore 🎁</a>
    </div>
    <div data-animate style="transition-delay:0.15s;">
      <img src="{{ 'coppia-cani.png' | asset_url }}" alt="Regalo Caricatura Animale" width="600" height="600" style="border-radius:var(--radius-lg); box-shadow:var(--shadow-lg);" loading="lazy">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner Regalo",
  "settings": [],
  "presets": [
    {
      "name": "Banner Regalo"
    }
  ]
}
{% endschema %}
